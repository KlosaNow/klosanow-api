{
  "name": "auth",
  "version": "1.0.2",
  "description": "The authentication service of the API",
  "main": "./src/server.js",
  "scripts": {

    "build": "rimraf dist && npx tsc",
    "prestart": "npm run build",
    "start": "node --unhandled-rejections=strict dist/server.js",
    "debug": "SET DEBUG=* && npm run start",
    "dev": "SET DEBUG=* && nodemon --exec ts-node ./src/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KlosaNow/klosanow-api.git"
  },
